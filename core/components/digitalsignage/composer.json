{
  "name": "sterc/digitalsignage",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "DigitalSignage\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "mcp/sdk": "^0.8",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/log": "^2.0"
  },
  "replace": {
    "psr/container": "*",
    "psr/http-client": "*",
    "psr/http-factory": "*",
    "psr/http-message": "*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
